# --- Data ---
# Raw data in data/bronze is tracked. Everything derived from it is not:
# regenerate the silver and gold layers with `python -m src.train`.
data/silver/*
!data/silver/.gitkeep
data/gold/*
!data/gold/.gitkeep

# Trained models are build artifacts, not source.
data/models/*
!data/models/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# --- Jupyter ---
.ipynb_checkpoints/
*.nbconvert.ipynb

# --- Node (screenshot tooling, kept local) ---
node_modules/
take_screenshots.js
package.json
package-lock.json

# --- System files ---
.DS_Store
Thumbs.db

# Generated on demand by the screenshot tooling, not a project artifact.
docs/screenshots/sample_upload.csv
